{
  "name": "@storybook/web",
  "version": "1.0.0",
  "description": "Frontend for Image-to-Video Storybook",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cap:add": "cap add android",
    "cap:sync": "node scripts/cap-sync.mjs",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^7.9.0",
    "@capacitor/core": "^7.9.0",
    "axios": "^1.7.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.10.0",
    "next": "^16.3.3",
    "next-auth": "^4.24.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.13.0",
    "recharts": "^2.12.0",
    "sonner": "^1.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.9.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.0",
    "quill": "^2.0.2",
    "react-quill": "^3.1.0",
    "vitest": "^1.2.0"
  }
}
